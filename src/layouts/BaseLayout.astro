---
// Layout de base : <head> SEO + Open Graph + Twitter Card, en-tête et pied de page.
import { SITE } from "../config/site";

interface Props {
  title: string;
  description?: string;
  /** Chemin ou URL d'une image de partage (Open Graph). */
  image?: string;
  /** Type Open Graph : "website" pour les pages, "article" pour le blog. */
  type?: "website" | "article";
  /** Empêche l'indexation de la page (ex : pages légales). */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  type = "website",
  noindex = false,
} = Astro.props;

// URLs absolues (requis par Open Graph). Astro.site vient de astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <header class="site-header">
      <nav class="container">
        <a href="/" class="logo">{SITE.name}</a>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/a-propos">À propos</a></li>
        </ul>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="affiliate-disclosure">
          ⚖️ Divulgation : ce site contient des liens affiliés. Si vous achetez via
          ces liens, nous pouvons percevoir une commission, sans surcoût pour vous.
        </p>
        <p>© {new Date().getFullYear()} {SITE.name} · <a href="/mentions-legales">Mentions légales</a></p>
      </div>
    </footer>

    <style is:global>
      :root {
        --max-width: 1000px;
        --accent: #2563eb;
        --accent-dark: #1d4ed8;
        --text: #111827;
        --muted: #6b7280;
        --bg: #ffffff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.6;
      }
      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1rem; }
      a { color: var(--accent); }

      .site-header { border-bottom: 1px solid #eee; }
      .site-header nav {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 1rem; padding-bottom: 1rem;
      }
      .logo { font-weight: 800; font-size: 1.3rem; text-decoration: none; color: var(--text); }
      .site-header ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
      .site-header a { text-decoration: none; color: var(--text); }
      .site-header a:hover { color: var(--accent); }

      main { min-height: 70vh; padding: 2.5rem 0; }

      .site-footer { border-top: 1px solid #eee; padding: 2rem 0; color: var(--muted); font-size: 0.9rem; }
      .affiliate-disclosure {
        background: #f0f6ff; border: 1px solid #d6e4ff;
        padding: 0.75rem 1rem; border-radius: 8px;
      }
    </style>
  </body>
</html>
