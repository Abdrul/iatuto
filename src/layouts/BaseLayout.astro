---
// Layout de base : <head> SEO + Open Graph + Twitter Card, en-tête et pied de page.
import { SITE } from "../config/site";
import { getUsedCategories, categoryMeta } from "../lib/categories";

// Onglets de catégorie générés à partir des catégories réellement utilisées
// par un article publié (aucune valeur figée ici).
const navCategories = (await getUsedCategories()).map((category) => ({
  href: `/categorie/${category}`,
  label: categoryMeta(category).label,
}));

interface Props {
  title: string;
  description?: string;
  /** Chemin ou URL d'une image de partage (Open Graph). */
  image?: string;
  /** Type Open Graph : "website" pour les pages, "article" pour le blog. */
  type?: "website" | "article";
  /** Empêche l'indexation de la page (ex : pages légales). */
  noindex?: boolean;
  /** Masque l'en-tête global (ex : la home qui intègre sa nav dans le hero). */
  showHeader?: boolean;
  /** Rend le contenu pleine largeur, sans conteneur ni padding (sections gérées par la page). */
  bleed?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  type = "website",
  noindex = false,
  showHeader = true,
  bleed = false,
} = Astro.props;

// URLs absolues (requis par Open Graph). Astro.site vient de astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SITE.ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Typographie : Fraunces (titres) + Inter (texte courant) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Balisage additionnel par page (JSON-LD, etc.) -->
    <slot name="head" />
  </head>

  <body>
    {showHeader && (
      <header class="site-header">
        <nav class="container">
          <a href="/" class="logo">{SITE.name}</a>
          <ul>
            <li><a href="/blog">Blog</a></li>
            {navCategories.map((cat) => (
              <li><a href={cat.href}>{cat.label}</a></li>
            ))}
            <li><a href="/a-propos">À propos</a></li>
          </ul>
        </nav>
      </header>
    )}

    <main>
      {bleed ? <slot /> : <div class="page"><slot /></div>}
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="affiliate-disclosure">
          ⚖️ Divulgation : ce site contient des liens affiliés. Si vous achetez via
          ces liens, nous pouvons percevoir une commission, sans surcoût pour vous.
        </p>
        <p>© {new Date().getFullYear()} {SITE.name} · <a href="/mentions-legales">Mentions légales</a></p>
      </div>
    </footer>

    <style is:global>
      :root {
        --max-width: 1100px;

        /* Palette de marque */
        --bg: #fbfaf7;            /* blanc cassé chaud */
        --indigo: #2d2456;       /* indigo de marque */
        --indigo-light: #c9c3e8; /* texte sur fond sombre */
        --amber: #e08a3c;        /* accent (boutons, liens d'action) */
        --amber-dark: #c5752c;

        --text: #1a1726;         /* texte principal */
        --text-2: #4a4658;       /* texte secondaire */
        --muted: #6a6678;        /* texte tertiaire */
        --border: #ece8e0;       /* bordures */

        /* Badges catégories */
        --violet: #7a5bc7;
        --violet-bg: #eeeaf9;
        --green: #1d9e75;
        --green-bg: #e1f5ee;
        --amber-badge: #b26b2b;
        --amber-badge-bg: #fbe9d7;

        /* Compat. anciens composants/pages */
        --accent: var(--indigo);
        --accent-dark: var(--amber);

        /* Typographie */
        --font-serif: "Fraunces", Georgia, "Times New Roman", serif;
        --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);
        background: var(--bg);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 {
        font-family: var(--font-serif);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--text);
      }

      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1.25rem; }

      a { color: var(--accent); }

      main { min-height: 70vh; }
      .page { max-width: var(--max-width); margin: 0 auto; padding: 3rem 1.25rem; }

      /* Focus clavier visible et cohérent partout */
      a:focus-visible,
      button:focus-visible,
      :focus-visible {
        outline: 3px solid var(--amber);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .site-header { border-bottom: 1px solid var(--border); background: var(--bg); }
      .site-header nav {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 1.1rem; padding-bottom: 1.1rem;
      }
      .logo { font-family: var(--font-serif); font-weight: 600; font-size: 1.35rem; text-decoration: none; color: var(--text); }
      .site-header ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
      .site-header a { text-decoration: none; color: var(--text-2); font-weight: 500; }
      .site-header a:hover { color: var(--amber); }

      .site-footer { border-top: 1px solid var(--border); padding: 2.5rem 0; color: var(--muted); font-size: 0.9rem; }
      .affiliate-disclosure {
        background: #fff; border: 1px solid var(--border);
        padding: 0.85rem 1.1rem; border-radius: 10px;
      }
      .site-footer a { color: var(--text-2); }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
