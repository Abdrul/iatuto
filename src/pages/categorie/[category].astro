---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { categoryMeta } from "../../lib/categories";
import { SITE } from "../../config/site";

// Génère une page par catégorie réellement utilisée par un article publié.
// Aucune catégorie n'est codée en dur : la liste se déduit de la collection,
// donc une nouvelle catégorie dans un futur article crée sa page tout seul.
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => {
    const articles = posts
      .filter((post) => post.data.category === category)
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

    return { params: { category }, props: { category, articles } };
  });
}

const { category, articles } = Astro.props;
const meta = categoryMeta(category);

const seoTitle = `${meta.heading} — ${SITE.name}`;
const seoDescription = meta.intro;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <header class="cat-head">
    <p class="cat-eyebrow">Catégorie</p>
    <h1>{meta.heading}</h1>
    <p class="cat-intro">{meta.intro}</p>
  </header>

  {articles.length > 0 ? (
    <div class="posts-grid">
      {articles.map((post) => {
        const cat = categoryMeta(post.data.category);
        return (
          <article class="card">
            <a class="card-link" href={`/blog/${post.id}`}>
              <span class="badge" style={`background:${cat.bg};color:${cat.color};`}>
                {cat.label}
              </span>
              <h2 class="card-title">{post.data.title}</h2>
              <time class="card-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}
              </time>
              <p class="card-desc">{post.data.description}</p>
            </a>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="empty">Aucun article dans cette catégorie pour le moment.</p>
  )}

  <p class="back-link"><a href="/blog">← Tous les articles</a></p>

  <style>
    /* ---------- EN-TÊTE ---------- */
    .cat-head { margin-bottom: 3rem; }
    .cat-eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--amber);
      margin: 0 0 0.5rem;
    }
    .cat-head h1 { font-size: 2.6rem; margin: 0 0 0.75rem; }
    .cat-intro {
      color: var(--text-2);
      font-size: 1.15rem;
      max-width: 620px;
      margin: 0;
    }

    /* ---------- GRILLE DE CARTES (identique à /blog) ---------- */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #fff;
      transition: box-shadow 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
    }
    .card:hover {
      box-shadow: 0 12px 30px rgba(45, 36, 86, 0.08);
      transform: translateY(-2px);
      border-color: #e0dbd0;
    }
    .card-link {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      height: 100%;
      padding: 1.5rem;
      text-decoration: none;
      color: inherit;
    }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      margin-bottom: 1rem;
    }
    .card-title {
      font-size: 1.3rem;
      margin: 0 0 0.4rem;
      color: var(--text);
    }
    .card-date {
      display: block;
      color: var(--muted);
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }
    .card-desc {
      color: var(--text-2);
      margin: 0;
      font-size: 0.98rem;
    }

    /* ---------- ÉTAT VIDE + RETOUR ---------- */
    .empty {
      font-family: var(--font-serif);
      font-size: 1.4rem;
      color: var(--text-2);
      padding: 2rem 0 1rem;
      margin: 0;
    }
    .back-link { margin-top: 2.5rem; }
    .back-link a { color: var(--text-2); text-decoration: none; font-weight: 500; }
    .back-link a:hover { color: var(--amber); }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 640px) {
      .cat-head { margin-bottom: 2.25rem; }
      .cat-head h1 { font-size: 2.1rem; }
      .cat-intro { font-size: 1.05rem; }
      .posts-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
