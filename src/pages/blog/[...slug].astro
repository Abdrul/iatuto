---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

// Génère une page statique par article Markdown.
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Couleurs de badge par catégorie (cf. content.config.ts : comparatif | tutoriel | avis | guide).
const CATEGORY_STYLES: Record<string, { label: string; bg: string; color: string }> = {
  comparatif: { label: "Comparatif", bg: "#e1f5ee", color: "#1d9e75" },
  guide: { label: "Guide", bg: "#eeeaf9", color: "#7a5bc7" },
  tutoriel: { label: "Tutoriel", bg: "#eeeaf9", color: "#7a5bc7" },
  avis: { label: "Avis", bg: "#faeeda", color: "#854f0b" },
};

const cat = CATEGORY_STYLES[post.data.category] ?? {
  label: post.data.category.charAt(0).toUpperCase() + post.data.category.slice(1),
  bg: "var(--border)",
  color: "var(--text-2)",
};

const dateFormat: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
const publishedLabel = post.data.pubDate.toLocaleDateString("fr-FR", dateFormat);
const updatedLabel = post.data.updatedDate?.toLocaleDateString("fr-FR", dateFormat);

// Données structurées JSON-LD (type Article). On n'inclut pas les champs vides.
const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Person", name: post.data.author },
  publisher: { "@type": "Organization", name: "iatuto" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
if (post.data.image) {
  articleSchema.image = new URL(post.data.image, Astro.site).href;
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} is:inline />

  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a>
    <span aria-hidden="true">›</span>
    <a href="/blog">Blog</a>
    <span aria-hidden="true">›</span>
    <span class="current" aria-current="page">{post.data.title}</span>
  </nav>

  <article class="post">
    <header class="post-head">
      <span class="badge" style={`background:${cat.bg};color:${cat.color};`}>{cat.label}</span>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <span>Publié le {publishedLabel}</span>
        {updatedLabel && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>Mis à jour le {updatedLabel}</span>
          </>
        )}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a href="/blog" class="back-link">← Retour au blog</a>
    </footer>
  </article>

  <style>
    /* ---------- FIL D'ARIANE ---------- */
    .breadcrumb {
      max-width: 700px;
      margin: 0 auto 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-2);
    }
    .breadcrumb a { color: var(--text-2); text-decoration: none; }
    .breadcrumb a:hover { color: var(--amber); }
    .breadcrumb .current {
      color: var(--muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 100%;
    }

    /* ---------- EN-TÊTE DE L'ARTICLE ---------- */
    .post { max-width: 700px; margin: 0 auto; }
    .post-head { margin-bottom: 2.5rem; }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      margin-bottom: 1.1rem;
    }
    .post-head h1 {
      font-size: 2.6rem;
      line-height: 1.15;
      margin: 0 0 0.9rem;
    }
    .meta {
      color: var(--muted);
      font-size: 0.92rem;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .meta-sep { color: var(--border); }

    /* ---------- CORPS DE L'ARTICLE (zone de lecture) ---------- */
    .prose {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--text);
    }
    .prose :global(p) { margin: 0 0 1.4rem; }

    .prose :global(h2) {
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.7rem;
      line-height: 1.25;
      margin: 2.75rem 0 1rem;
      color: var(--text);
    }
    .prose :global(h3) {
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.35rem;
      line-height: 1.3;
      margin: 2rem 0 0.75rem;
      color: var(--text);
    }

    .prose :global(ul),
    .prose :global(ol) { margin: 0 0 1.4rem; padding-left: 1.4rem; }
    .prose :global(li) { margin-bottom: 0.5rem; }
    .prose :global(li::marker) { color: var(--amber); }

    .prose :global(a) {
      color: var(--amber);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose :global(a:hover) { color: var(--amber-dark); }

    .prose :global(strong) { color: var(--text); font-weight: 600; }

    .prose :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      margin: 1.5rem 0;
    }

    .prose :global(blockquote) {
      border-left: 4px solid var(--indigo);
      background: #f3f1fa;
      margin: 1.75rem 0;
      padding: 0.85rem 1.25rem;
      border-radius: 0 8px 8px 0;
      color: var(--text-2);
    }
    .prose :global(blockquote p) { margin: 0.4rem 0; }

    .prose :global(hr) {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    .prose :global(code) {
      font-size: 0.9em;
      background: #f1eee8;
      padding: 0.15em 0.4em;
      border-radius: 5px;
    }
    .prose :global(pre) {
      background: var(--indigo);
      color: #f5f3fb;
      padding: 1.1rem 1.25rem;
      border-radius: 10px;
      overflow-x: auto;
      margin: 1.5rem 0;
    }
    .prose :global(pre code) { background: none; padding: 0; }

    /* ---------- TABLEAUX (comparatifs) ---------- */
    .prose :global(.table-wrap),
    .prose :global(table) { margin: 1.75rem 0; }
    /* Scroll horizontal sur mobile sans casser la mise en page. */
    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.98rem;
      display: block;
      overflow-x: auto;
    }
    .prose :global(th),
    .prose :global(td) {
      border: 1px solid var(--border);
      padding: 0.65rem 0.9rem;
      text-align: left;
      vertical-align: top;
    }
    .prose :global(thead th) {
      background: #f3f1fa;
      color: var(--indigo);
      font-weight: 600;
    }
    .prose :global(tbody tr:nth-child(even)) { background: #faf8f3; }

    /* ---------- PIED D'ARTICLE ---------- */
    .post-foot {
      margin-top: 3rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--border);
    }
    .back-link {
      color: var(--amber);
      font-weight: 600;
      text-decoration: none;
    }
    .back-link:hover { color: var(--amber-dark); text-decoration: underline; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 640px) {
      .post-head h1 { font-size: 2rem; }
      .prose { font-size: 1.05rem; }
      .prose :global(h2) { font-size: 1.45rem; }
      .prose :global(h3) { font-size: 1.25rem; }
      /* Sur mobile, on force le scroll horizontal plutôt que d'écraser les colonnes. */
      .prose :global(td),
      .prose :global(th) { white-space: nowrap; }
    }
  </style>
</BaseLayout>
